# -------------------------------------------------------------
# BREWLITE MONOREPO - ENVIRONMENT CONFIGURATION TEMPLATE
# Sao chép tệp này thành .env để sử dụng cho môi trường cục bộ
# -------------------------------------------------------------

# Backend API Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=api

# PostgreSQL Database Configuration (khớp với docker-compose.yml cổng 5433 -> 5432)
POSTGRES_USER=brewlite_user
POSTGRES_PASSWORD=brewlite_password
POSTGRES_DB=brewlite_ass2_db
DATABASE_URL=postgresql://brewlite_user:brewlite_password@localhost:5433/brewlite_ass2_db?schema=public

# Security & Authentication (JWT)
JWT_SECRET=brewlite_development_jwt_secret_key_32_characters_minimum
JWT_EXPIRES_IN=7d

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME="BrewLite Order"
