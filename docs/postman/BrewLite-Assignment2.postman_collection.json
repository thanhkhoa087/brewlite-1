    {
      "name": "1. Public - Health, Menu & BOM Inventory",
      "item": [
        {
          "name": "GET Health Check (Render + Supabase DB)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('Service status is ok/degraded', function () {",
                  "  pm.expect(body.status).to.be.oneOf(['ok', 'degraded']);",
                  "});",
                  "pm.test('Database is connected (up)', function () {",
                  "  pm.expect(body.info && body.info.database && body.info.database.status).to.eql('up');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{host_url}}/health"
          }
        },
        {
          "name": "GET Danh sách Menu (Tính số ly từ nguyên liệu thô)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const products = pm.response.json();",
                  "pm.test('Returns non-empty products with stock & basePrice', function () {",
                  "  pm.expect(products).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(products[0]).to.have.property('stock');",
                  "  pm.expect(products[0]).to.have.property('basePrice');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products"
          }
        },
        {
          "name": "GET Lọc Menu theo danh mục (Cà phê)",
