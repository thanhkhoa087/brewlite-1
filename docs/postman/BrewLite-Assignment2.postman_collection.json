    {
      "name": "3. Khách hàng - Bảo mật, Chống sửa giá, Vượt kho & Hủy đơn",
      "item": [
        {
          "name": "POST Tạo đơn thiếu JWT (Chặn 401 Unauthorized)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 401 Unauthorized', function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"productId\": \"prod-001\", \"size\": \"S\", \"quantity\": 1 }]\n}"
            },
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "POST Tạo đơn - Test CHỐNG SỬA GIÁ (unitPrice=1000 -> Server tính 70,000đ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
                  "const order = pm.response.json();",
                  "pm.test('Server bỏ qua giá 1000đ, tính đúng từ DB (35,000 x 2 = 70,000)', function () {",
                  "  pm.expect(order.subTotal).to.eql(70000);",
                  "  pm.expect(order.totalAmount).to.eql(70000);",
                  "  pm.expect(order.status).to.eql('PENDING');",
                  "});",
                  "pm.environment.set('order_to_cancel', order.id);",
                  "pm.collectionVariables.set('order_to_cancel', order.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"prod-001\",\n      \"size\": \"M\",\n      \"sweetLevel\": 70,\n      \"iceLevel\": 50,\n      \"toppings\": [],\n      \"unitPrice\": 1000,\n      \"quantity\": 2\n    }\n  ],\n  \"note\": \"Demo Postman: cố tình sửa unitPrice=1000 để test Server Price Integrity\"\n}"
            },
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "PATCH User B cố hủy trộm đơn User A (Chặn 403 Forbidden)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 403 Forbidden (Chặn hủy đơn của người khác)', function () {",
                  "  pm.response.to.have.status(403);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_b}}" }],
            "url": "{{base_url}}/orders/{{order_to_cancel}}/cancel"
          }
        },
        {
          "name": "PATCH User A hủy đơn đặt nhầm (PENDING -> CANCELLED & hoàn kho)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Order status is CANCELLED', function () {",
                  "  pm.expect(pm.response.json().order.status).to.eql('CANCELLED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/orders/{{order_to_cancel}}/cancel"
          }
        },
        {
          "name": "PATCH Hủy lại đơn đã CANCELLED lần 2 (Chặn 400 Bad Request)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 400 Bad Request (Không cho hủy 2 lần)', function () {",
                  "  pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token_a}}" }],
            "url": "{{base_url}}/orders/{{order_to_cancel}}/cancel"
          }
        },
        {
          "name": "POST Tạo đơn - Test VƯỢT TỒN KHO (999 ly -> 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409 Conflict (Chặn bán vượt tồn kho)', function () {",
                  "  pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{ \"productId\": \"prod-001\", \"size\": \"S\", \"quantity\": 999 }],\n  \"note\": \"Demo Postman: đặt vượt định lượng nguyên liệu\"\n}"
            },
            "url": "{{base_url}}/orders"
          }
        }
      ]
    },
    {
      "name": "4. Khách hàng - Checkout, Thanh toán Idempotency & Theo dõi đơn",
      "item": [
        {
          "name": "POST Tạo đơn hợp lệ (kèm Voucher SGUFREE giảm 15,000đ)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201 Created', function () { pm.response.to.have.status(201); });",
                  "const order = pm.response.json();",
                  "pm.test('Applied SGUFREE 15,000 VND discount', function () {",
                  "  pm.expect(order.discountAmount).to.eql(15000);",
                  "  pm.expect(order.status).to.eql('PENDING');",
                  "});",
                  "const idemKey = 'postman-idem-' + Date.now();",
                  "pm.environment.set('order_id', order.id);",
                  "pm.collectionVariables.set('order_id', order.id);",
                  "pm.environment.set('order_amount', order.totalAmount);",
                  "pm.collectionVariables.set('order_amount', order.totalAmount);",
                  "pm.environment.set('idempotency_key', idemKey);",
                  "pm.collectionVariables.set('idempotency_key', idemKey);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_a}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"productId\": \"prod-001\",\n      \"size\": \"M\",\n      \"sweetLevel\": 70,\n      \"iceLevel\": 50,\n      \"toppings\": [\"Kem Cheese phô mai béo\"],\n      \"quantity\": 1\n    }\n  ],\n  \"promotionCode\": \"SGUFREE\",\n  \"note\": \"Giao tại quầy SGU\"\n}"
            },
            "url": "{{base_url}}/orders"
          }
        },
        {
          "name": "POST Thanh toán lần 1 (Kèm Idempotency-Key -> PAID)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "pm.test('Order paid successfully', function () {",
                  "  pm.expect(res.status).to.eql('PAID');",
                  "  pm.expect(res.transactionCode).to.be.a('string').and.not.be.empty;",
                  "});",
                  "pm.environment.set('tx_code', res.transactionCode);",
                  "pm.collectionVariables.set('tx_code', res.transactionCode);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"method\": \"MOMO\",\n  \"amount\": {{order_amount}}\n}"
            },
            "url": "{{base_url}}/payments/process"
          }
        },
        {
          "name": "POST Thanh toán lần 2 (Replay cùng Idempotency-Key - không trừ đúp)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200 OK (Idempotent Replay)', function () { pm.response.to.have.status(200); });",
                  "const res = pm.response.json();",
                  "pm.test('Returns identical transactionCode without double charge', function () {",
                  "  pm.expect(res.isIdempotentReplay).to.eql(true);",
                  "  pm.expect(res.transactionCode).to.eql(pm.variables.get('tx_code'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
